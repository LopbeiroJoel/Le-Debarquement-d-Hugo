{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compiler",
      "type": "shell",
      "command": "./gradlew core:classes lwjgl3:classes",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "Lancer",
      "type": "shell",
      "command": "./gradlew lwjgl3:run",
      "problemMatcher": []
    },
    {
      "label": "Tester",
      "type": "shell",
      "command": "./gradlew core:check",
      "problemMatcher": [
        "$javac"
      ]
    }
  ]
}