{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "./gradlew core:classes hugo:classes",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ],
      "windows": {
        "command": ".\\gradlew.bat core:classes hugo:classes"
      }
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./gradlew hugo:run",
      "problemMatcher": [],
      "windows": {
        "command": ".\\gradlew.bat hugo:run"
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "./gradlew core:check",
      "problemMatcher": [
        "$javac"
      ],
      "windows": {
        "command": ".\\gradlew.bat core:check"
      }
    }
  ]
}
